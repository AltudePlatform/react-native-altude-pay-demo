    "axios": "^1.18.1",
    "bs58": "^6.0.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-safe-area-context": "^5.1.0",
    "react-native-screens": "^4.5.0",
    "react-native-svg": "^15.11.2",
