{
  "name": "AltudePay",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.8.0",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "postinstall": "patch-package",
    "check:altude-sdk-boundary": "node scripts/check-altude-sdk-boundary.cjs",
    "check:react-native-exports": "node scripts/check-react-native-exports.mjs",
    "smoke:startup": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output .tmp-altude-npm-check/startup.bundle --assets-dest .tmp-altude-npm-check/assets",
    "smoke:startup:strict": "npm run type-check && npm run smoke:startup",
    "start": "react-native start",
    "test": "jest",
    "test:devnet-live": "node scripts/devnet-integration.mjs",
    "type-check": "npm run check:altude-sdk-boundary && tsc --noEmit"
  },
  "dependencies": {
    "@altude/core": "^0.1.1",
    "@altude/gasstation": "^2.2.0",
    "@dynamic-labs/client": "^4.95.1",
    "@dynamic-labs/react-native-extension": "^4.95.1",
    "@dynamic-labs/solana-extension": "^4.95.1",
    "@dynamic-labs/viem-extension": "^4.95.1",
    "@noble/curves": "^2.2.0",
    "@react-native-anywhere/polyfill-base64": "^0.0.1-alpha.0",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-documents/picker": "^12.0.2",
    "@react-navigation/bottom-tabs": "^7.3.14",
    "@react-navigation/native": "^7.1.9",
    "@react-navigation/stack": "^7.10.19",
    "@scure/base": "^1.2.6",
    "@solana-program/token": "^0.5.1",
    "@solana/kit": "^2.3.0",
    "@solana/web3.js": "^1.98.1",
    "@tanstack/react-query": "^5.64.2",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "fast-text-encoding": "^1.0.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keychain": "^10.0.0",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-vision-camera": "^4.7.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tweetnacl": "^1.0.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.9",
    "@babel/plugin-transform-class-static-block": "^7.29.7",
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@babel/preset-env": "^7.25.9",
    "@babel/runtime": "^7.26.0",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@react-native-community/cli-platform-ios": "^20.2.0",
    "@react-native/babel-preset": "^0.86.3",
    "@react-native/codegen": "^0.86.3",
    "@react-native/community-cli-plugin": "^0.86.3",
    "@react-native/eslint-config": "^0.82.1",
    "@react-native/jest-preset": "^0.86.3",
    "@react-native/metro-babel-transformer": "^0.86.3",
    "@react-native/metro-config": "^0.86.3",
    "@react-native/typescript-config": "^0.82.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.1",
    "@types/react-native": "^0.73.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.0",
    "prettier": "^2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "setupFiles": [
      "<rootDir>/__tests__/setup/jestSetup.js"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/__tests__/setup/"
    ],
    "transformIgnorePatterns": [],
    "testEnvironmentOptions": {
      "customExportConditions": [
        "node",
        "node-addons"
      ]
    }
  },
  "engines": {
    "node": ">=20.19"
  }
}
