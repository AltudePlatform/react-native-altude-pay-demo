{
  "name": "AltudePay",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.8.0",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "postinstall": "patch-package",
    "check:react-native-exports": "node scripts/check-react-native-exports.mjs",
    "smoke:startup": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output .tmp-altude-npm-check/startup.bundle --assets-dest .tmp-altude-npm-check/assets",
    "smoke:startup:strict": "npm run type-check && npm run smoke:startup",
    "start": "react-native start",
    "test": "jest",
    "test:devnet-live": "node scripts/devnet-integration.mjs",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@altude/core": "^0.1.1",
    "@altude/gasstation": "^2.1.0",
    "@noble/curves": "^1.9.7",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-navigation/bottom-tabs": "^7.3.14",
    "@react-navigation/native": "^7.1.9",
    "@react-navigation/stack": "^7.10.19",
    "@scure/base": "^1.2.6",
    "@scure/bip32": "^1.7.0",
    "@scure/bip39": "^1.6.0",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/react-query": "^5.64.2",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "react": "19.1.1",
    "react-native": "0.82.1",
    "react-native-gesture-handler": "2.28.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-reanimated": "^4.3.4",
    "react-native-safe-area-context": "^5.1.0",
    "react-native-screens": "^4.11.1",
    "react-native-svg": "^15.11.2",
    "react-native-vision-camera": "^4.7.0",
    "react-native-worklets": "^0.8.3",
    "tweetnacl": "^1.0.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.9",
    "@babel/preset-env": "^7.25.9",
    "@babel/runtime": "^7.26.0",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@react-native-community/cli-platform-ios": "^20.2.0",
    "@react-native/babel-preset": "^0.82.1",
    "@react-native/codegen": "0.82.1",
    "@react-native/community-cli-plugin": "0.82.1",
    "@react-native/eslint-config": "^0.82.1",
    "@react-native/metro-config": "^0.82.1",
    "@react-native/typescript-config": "^0.82.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.1",
    "@types/react-native": "^0.73.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.0",
    "prettier": "^2.8.8",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "react-native",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "transformIgnorePatterns": []
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.6",
    "@scure/bip32": "^1.7.0",
    "@scure/bip39": "^1.6.0"
  }
}
