<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.App.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/altude_canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
        <item name="android:windowBackground">@color/altude_canvas</item>
        <item name="android:statusBarColor">@color/altude_canvas</item>
        <item name="android:navigationBarColor">@color/altude_canvas</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

</resources>